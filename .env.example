# Copy values into the process environment; never commit a real .env file.
COCOS_AGENT_PROJECT_ROOT=E:/path/to/cocos-project
COCOS_AGENT_OCR_ENGINE=windows-ocr
COCOS_AGENT_WINDOWS_OCR_LANG=zh-CN
COCOS_AGENT_TESSERACT_LANG=eng
COCOS_AGENT_GATEWAY_URL=wss://gateway.example.com/chat
COCOS_AGENT_GATEWAY_TOKEN=
COCOS_AGENT_GATEWAY_MODEL=agent-default
COCOS_AGENT_CCS_ROUTE=current
COCOS_AGENT_CCS_URL=wss://gateway.example.com/ccs
COCOS_AGENT_CCS_INSECURE=false
