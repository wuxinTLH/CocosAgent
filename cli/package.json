{
  "name": "cocos-agent-cli",
  "version": "0.0.3-a",
  "cocosAgentVersion": "v0.0.0.3-a",
  "description": "Cocos Agent CLI: WorkFlow, memory, skills, MCP and Cocos Creator bridge",
  "type": "module",
  "bin": {
    "cocos-agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && node scripts/check-javascript.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "docs:check": "npm run build && node dist/index.js docs check",
    "verify": "npm run lint && npm run test && npm run docs:check"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
