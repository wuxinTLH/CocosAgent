  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
